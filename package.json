{
  "name": "dsh-astra",
  "version": "0.1.0",
  "description": "Animated three-row starfield status view for dsh-TUI",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "import": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "engines": { "node": "^22.19 || >=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.1" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-harness-tui/dsh-tui": ">=0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-harness-tui/dsh-tui": "^0.10.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "keywords": ["dsh-tui","dsh-plugin","astra","starfield","visual-effect","terminal","ink"],
  "repository": { "type": "git", "url": "https://github.com/lql341/dsh-astra.git" }
}
